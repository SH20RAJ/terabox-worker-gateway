{
  "name": "terabox-worker-gateway",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:secrets": "wrangler deploy --secrets-file .env",
    "check": "wrangler deploy --dry-run",
    "check:all": "npm run check && npm run proxy:check",
    "proxy:dev": "wrangler dev --config proxy-worker/wrangler.jsonc",
    "proxy:deploy": "wrangler deploy --config proxy-worker/wrangler.jsonc",
    "proxy:deploy:secrets": "wrangler deploy --config proxy-worker/wrangler.jsonc --secrets-file .env",
    "proxy:check": "wrangler deploy --config proxy-worker/wrangler.jsonc --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.94.0"
  }
}
